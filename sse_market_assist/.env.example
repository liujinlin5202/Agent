# ============================================================
# sse-market-assist 配置模板（复制为 .env 并填入真实值，chmod 600）
# ============================================================

# ---- 主通道：集市自有网关（OpenAI 兼容；2026-09-10 起为主用）----
# 与 tech-digest 的主通道同网关同 key。注意：网关 deepseek 系模型不接受
# reasoning_effort="none"（400 ModelArts.81001）；若换 qwen3.8-27b-awq 则必须设 none。
SSE_MARKET_API_KEY=sk-xxx
SSE_MARKET_BASE_URL=https://api.<MARKET_DOMAIN>/v1
SSE_MARKET_MODEL=deepseek-v4-flash

# ---- 备用通道：DeepSeek 官方（主通道失败时自动切换；留空则退化为单通道）----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 判断层（2026-09-12）：按 prompt 体量分流——小 → qwen（同一网关同 key），大 → deepseek ----
# 阈值按"实际拼装后的 prompt"的 token 预估计（非 ASCII 1 token/字，保守上界，实测高估 ~9%）；
# 安全不变式：阈值 + 1536(输出) + 2000(余量) ≤ ASSIST_SMALL_MODEL_WINDOW，越界自动全程走主通道（不冒险）
# 回滚：ASSIST_ROUTE_ENABLED=0 → 恢复单通道（与判断层上线前完全一致）
ASSIST_ROUTE_ENABLED=1
ASSIST_ROUTE_SMALL_MAX_TOKENS=20000
SSE_MARKET_SMALL_MODEL=qwen3.8-27b-awq
ASSIST_SMALL_MODEL_WINDOW=65536

# ---- Embedding（当前生效：平台 bge-m3 服务，OpenAI 兼容 /v1/embeddings，1024 维，无鉴权）----
# 2026-09-06 实测：旧路径 POST {base}/embed {"texts":[...]} 已下线（HTTP 301→HTTPS 且 POST 变 GET），
# 故 EMBEDDING_BASE_URL 必须配 HTTPS 直连：https://<MARKET_DOMAIN>:23011/v1 + EMBEDDING_MODE=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://<MARKET_DOMAIN>:23011/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODE=openai

# ---- Embedding 备选：其他 OpenAI 兼容服务（DashScope/SiliconFlow，切换时改下面 4 行）----
# EMBEDDING_MODE=openai
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# ---- Qdrant（平台 K8s 集群 qdrant.infra:6333，v1.19.0，需 API key）----
# 2026-09-06 实测：key 首字符是大写字母 I（误输成小写 L 会 401）
# 服务运行在 market-rag pod 内，走集群 DNS；市场服务器上等价入口为 127.0.0.1:25033
# 集合必须带平台前缀 gxxxxxx_（实测集群现存 gxxxxxx_docs，红线集合，勿动）
QDRANT_URL=http://qdrant.infra.svc.cluster.local:6333
QDRANT_API_KEY=<填入真实 key，勿提交>
QDRANT_COLLECTION=gxxxxxx_market_assist_v1

# ---- MySQL（只读）----
# 生产库 = 市场服务器 sse_market_db:3506（43 表，posts/pcomments/ccomments）。
# 本机运行用 127.0.0.1；在 market-rag pod 内运行时用 <SERVER_IP>（公网 IP，2026-09-06 实测可达）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3506
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=market

# ---- 服务自身 ----
ASSIST_LISTEN=127.0.0.1:19084
ASSIST_ADMIN_TOKEN=assist-admin-change-me
ASSIST_PARTITIONS=学习交流,实习就业,宿舍生活,技术分享,期末资料,生活日常,社团活动,组团捞人,课程专区,其他

# ---- 检索参数（rag-lab 基线权重，评测后调优）----
ASSIST_TOP_K=5
ASSIST_VECTOR_LIMIT=12
ASSIST_VECTOR_THRESHOLD=0.35
ASSIST_W_VECTOR=0.48
ASSIST_W_KEYWORD=0.27
ASSIST_W_HEAT=0.08
ASSIST_LLM_REWRITE=1

# ---- 索引参数 ----
ASSIST_CHUNK_SIZE=800
ASSIST_CHUNK_OVERLAP=120
ASSIST_EMBED_BATCH=10
ASSIST_EMBED_QPS=2

# ---- 自动同步 watch（发帖/评论自动入索引）----
# 独立进程周期轮询 MySQL，不在发帖请求路径上（Go 后端零改动），天然不阻塞发帖
ASSIST_SYNC_INTERVAL=30
ASSIST_SYNC_CLEANUP_CYCLES=20

# ---- WebSearch（站内相关内容不足时的站外搜索补充）----
# provider=bing：pod 直连 www.bing.com 实测可达；duckduckgo 域名在 pod 不可达，勿切。
# 触发条件：无候选 或 最高候选分 < WEB_SEARCH_MIN_SCORE（0.50；0.4~0.5 为边缘沾边，站外补充价值大）
WEB_SEARCH_ENABLED=1
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MIN_SCORE=0.50
