# ==== AI 主通道（market-deploy 网关）====
SSE_MARKET_BASE_URL=https://api.<MARKET_DOMAIN>/v1
SSE_MARKET_API_KEY=
SSE_MARKET_MODEL=qwen3.8-27b-awq

# ==== AI 备用通道（DeepSeek Anthropic 兼容端点；主通道失败时自动切换，2026-09-01）====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ==== 集市发帖（M2；refresh_token 由站长登录集市一次取得，轮换后自动更新）====
MARKET_REFRESH_TOKEN=
MARKET_USER_TELEPHONE=
# MARKET_BASE_URL=http://172.18.0.6:8080   # 集市 Go 后端容器 IP；留空自动解析（docker inspect，漂移自愈）

# ==== 任务参数（可选）====
TECH_DIGEST_TOP_N=15
TECH_DIGEST_LOAD_THRESHOLD=2.5
TECH_DIGEST_CHECK_LOAD=1
TECH_DIGEST_HTTP_TIMEOUT=20
TECH_DIGEST_RETAIN_DAYS=90
TECH_DIGEST_RUNLOG_RETAIN=500
